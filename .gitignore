# Python environments, bytecode, and test/tool caches
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.tox/

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Hugging Face and dataset caches (data itself keeps its existing rules below)
hf-cache/
**/hf-cache/
.cache/
**/.cache/
.huggingface/
**/.huggingface/
datasets_cache/
**/datasets_cache/

# Local environment secrets (keep the documented template tracked)
.env
.env.*
!.env.example

# Node and frontend build output
node_modules/
frontend/dist/
dist/
build/

# Model/checkpoint tracking policy: intentionally unchanged
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.keras

# Existing dataset tracking policy: retain only the image data README
/data/*
!/data/image/
/data/image/*
!/data/image/README.md

# Logs, temporary files, and generated local outputs
*.log
*.tmp
*.temp
*.bak
*.swp.tmp
logs/
/training/reports/
tmp/
temp/
output/
outputs/

# IDE and operating system files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
