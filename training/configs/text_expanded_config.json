    "maximum_training_tokens": 256,
    "learning_rate": 0.00001,
    "optimizer": "AdamW",
    "precision": "CUDA autocast fp16",
    "device": "cuda",
    "early_stopping": "validation macro-F1, patience 2",
    "inference_overflow": "overlapping windows, stride 32, dynamic padding, attention-mask weighted"
